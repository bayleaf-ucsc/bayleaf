{
  // The workers: their global is a DedicatedWorkerGlobalScope, not a Window.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["es2023", "webworker", "webworker.iterable"],
    // DuckDB-Wasm's synchronous browser bindings are not in its package exports;
    // build-duckdb.mjs aliases the same name to dist/duckdb-browser-blocking.mjs.
    "paths": { "duckdb-wasm-blocking": ["./node_modules/@duckdb/duckdb-wasm/dist/types/src/targets/duckdb-browser-blocking.d.ts"] }
  },
  "include": ["src/run/worker.ts", "src/run/worker-browser.ts", "src/pdf/worker.ts", "src/media/worker.ts", "src/duckdb/worker.ts", "src/local/worker.ts", "src/parakeet/worker.ts", "src/parakeet/parakeet.d.ts", "src/globals.d.ts"],
  "exclude": []
}
