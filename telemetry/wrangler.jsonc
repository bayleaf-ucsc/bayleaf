{
  "name": "bayleaf-telemetry-local",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-01",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false },
  "vars": {
    "TELEMETRY_ENABLED": "false",
    "BROWSER_ENABLED": "false",
    "DAYTONA_WEBHOOKS_ENABLED": "false",
    "DAYTONA_OTLP_ENABLED": "false",
    "RETENTION_DAYS": "7"
  },
  "d1_databases": [{
    "binding": "TELEMETRY_DB",
    "database_name": "bayleaf-telemetry-local",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "migrations"
  }],
  "triggers": { "crons": ["* * * * *"] }
}
