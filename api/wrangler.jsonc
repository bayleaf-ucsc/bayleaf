{
  "name": "bayleaf-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-31",
  "compatibility_flags": ["nodejs_compat"],
  
  // Observability - disabled to avoid unnecessary data accumulation.
  // Re-enable temporarily for debugging if needed.
  "observability": {
    "enabled": false
  },

  "routes": [
    { "pattern": "api.bayleaf.dev", "custom_domain": true }
  ],

  // D1 database for proxy key mappings
  // Create with: wrangler d1 create bayleaf-keys
  // Then run migration: wrangler d1 migrations apply bayleaf-keys
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bayleaf-keys",
      "database_id": "e249d6a6-41cf-4ab7-93d6-b677ac95b524"
    }
  ],

  // KV namespace for Campus Pass per-IP RPD counters.
  // Keys: `campus-rpd:<bucket>:<YYYY-MM-DD>` → JSON `{count: number}`, TTL 36h.
  // Created via: wrangler kv namespace create CAMPUS_RPD
  //
  // KV namespace for the generic /auth/claim/* device-flow handshake.
  // Keys: `claim:<CODE>` → JSON ClaimRecord (see routes/claim.ts), TTL 600s.
  // Created via: wrangler kv namespace create CLAIM_CODES
  "kv_namespaces": [
    {
      "binding": "CAMPUS_RPD",
      "id": "6b839ccbc7d14ddb86af4d7cb926eed2"
    },
    {
      "binding": "CLAIM_CODES",
      "id": "f435dc71d19148bab46fb0b14b99de2b"
    }
  ],

  // Environment variables (set via wrangler secret or dashboard)
  // These are placeholders - actual values should be set as secrets
  "vars": {
    // GCP Vertex AI Configuration
    //
    // VERTEX_ENABLED is the master kill-switch for the Vertex backend. It must
    // be exactly the string "true" to enable any `vertex:` routing, model
    // listing, or curated-model exposure. Any other value (including the empty
    // string or omission) disables Vertex entirely: `vertex:` chat completions
    // are rejected with 503, Vertex models are dropped from GET /models, and
    // `vertex:` entries are stripped from the OpenCode curated list.
    //
    // Disabled pending a credible zero-data-retention path with Google. The
    // project-level Abuse Monitoring opt-out request never received a response,
    // so we cannot promise ZDR parity with our OpenRouter path (issue #36).
    // Before flipping to "true", confirm the account's institutional contract
    // coverage and ZDR posture, then update the active/disabled and data-flow
    // claims in docs/privacy.html, docs/index.html, api/RETENTION.md,
    // politics/SECURITY.md, politics/FERPA.md, politics/HECVAT.md,
    // politics/POSITION.md, and politics/RESEARCH.md. Google is not listed as
    // an active subprocessor while this lane is off.
    "VERTEX_ENABLED": "false",
    "GCP_PROJECT_ID": "bayleafchat",
    "GCP_REGION": "us-central1",
    // GCP_SERVICE_ACCOUNT_EMAIL and GCP_SERVICE_ACCOUNT_PRIVATE_KEY should be set via `wrangler secret put`

    // Amazon Bedrock (bedrock-mantle) Configuration
    //
    // BEDROCK_ENABLED is the master kill-switch for the Bedrock backend, with
    // identical semantics to VERTEX_ENABLED: must be exactly "true" to enable
    // `bedrock:` routing, model listing, and curated-model exposure. Any other
    // value fails closed (503 on chat completions, dropped from GET /models,
    // stripped from the OpenCode curated list).
    //
    // The bearer token (BEDROCK_BEARER_TOKEN, a secret) is OpenAI-compatible
    // and static — no SigV4, no JWT minting. The POC token is from a personal
    // AWS account and carries NO UCSC BAA coverage; production must use a key
    // minted in the UCSC enterprise AWS account (issue #41).
    //
    // PAUSED 2026-07-29 (issue #25 follow-up): mantle's catalog turned out to
    // include closed-weight frontier models (claude-haiku-4-5, gpt-5.4/5.6,
    // grok-4.3) with no mechanical weights-availability field to filter on,
    // and its per-model data_retention metadata shows no 'none' mode for
    // those models. A hand-maintained list is exactly what issue #25 rejected,
    // so the backend is off until mantle exposes a predicate (or we accept a
    // maintained list). One env flip restores it; the code path is untouched.
    //
    // Re-enable checklist (details in api/AGENTS.md):
    //   1. Enterprise-account token with UCSC BAA (issue #41 Track B). For the
    //      enterprise setup, also apply AWS's SCP pattern denying
    //      bedrock-mantle:PutAccountDataRetention / project writes unless the
    //      mode is 'none' (condition key bedrock-mantle:DataRetentionMode),
    //      so no operator can ever flip the account to provider_data_share.
    //   2. DONE on the POC account 2026-07-29: mantle retention mode set to
    //      'none' (PUT /v1/data_retention) after granting the API-key IAM
    //      user bedrock-mantle:PutAccountDataRetention (the key ships without
    //      it; 403 access_denied until added). Verified live: gpt-5.4 reports
    //      status "unavailable", direct invocation rejected (HTTP 400),
    //      gpt-oss-120b still serves (HTTP 200). Account-scoped, so re-apply
    //      on the enterprise account; the item-1 SCP makes it permanent there.
    //   3. Weights listing: fetchBedrockModels already filters to ZDR-capable
    //      models, but closed-weight ZDR-capable ones (haiku, grok) pass, so
    //      a weights answer is still required before flip.
    //   4. Add AWS to docs/privacy.html subprocessors and update the
    //      active/disabled, account-coverage, and data-flow claims in
    //      docs/index.html, api/RETENTION.md, politics/SECURITY.md,
    //      politics/FERPA.md, politics/HECVAT.md, politics/DEPENDENCIES.md,
    //      politics/POSITION.md, and politics/RESEARCH.md.
    "BEDROCK_ENABLED": "false",

    // BayLeaf Sealed — attested confidential-inference lane (issue #55).
    //
    // SEALED_ENABLED is the master kill-switch, with the same fail-closed
    // semantics as VERTEX_ENABLED / BEDROCK_ENABLED: it must be exactly the
    // string "true" or the entire /sealed/* surface answers 503, including
    // /sealed/health, so a disabled lane leaks no upstream state.
    //
    // Unlike those two, Sealed is NOT an ALT_BACKENDS row. It has no `<prefix>:`
    // model routing and it never forwards plaintext. It relays EHBP-encrypted
    // (RFC 9180 HPKE) request bodies to a client-attested Tinfoil enclave, so
    // BayLeaf stays on the auth and metering path while lacking the
    // enclave-bound key needed to read prompts or completions. That makes it
    // the only lane where BayLeaf-operator zero-operator-access is a structural
    // property rather than a posture.
    //
    // ENABLED in production (2026-07-29). What the enablement gate required,
    //   and what it actually got:
    //   1. DONE. Secrets set via `wrangler secret put`: TINFOIL_ADMIN_KEY (mints
    //      per-user keys), TINFOIL_API_KEY (org key, now used only for the
    //      plaintext catalog at /sealed/models), and CAMPUS_SEALED_KEY (pool
    //      key for Campus Pass, which has no email and so cannot hold a
    //      per-user key).
    //   2. DONE. Migration 0005 applied. It rebuilds user_keys to make the
    //      OpenRouter columns nullable and add the Tinfoil ones, because backend
    //      keys are now minted on first use of each lane rather than at token
    //      issuance.
    //   3. DONE. Streaming confirmed. Usage accounting for streamed responses
    //      arrives in an HTTP trailer, which the Workers runtime does not
    //      expose. Non-streaming reports in a response header. The
    //      authoritative numbers are available out-of-band and DO include
    //      streaming, so this is a visibility gap, not an accounting gap.
    //   4. DONE. The Tinfoil subprocessor disclosure is live in
    //      docs/privacy.html and published at https://bayleaf.dev/privacy.html.
    //
    // Two gate items were deliberately NOT met. The reasoning is recorded here
    // rather than the requirement quietly dropped:
    //   - /sealed/policy (the C1-C6 rubric plus pinned enclave measurements) is
    //     NOT published, and is no longer treated as a prerequisite. A
    //     BayLeaf-served trust policy is circular: the guarantee is carried by
    //     the client, whose verifier already checks SEV-SNP hardware, Sigstore
    //     source provenance against a pinned config repo, runtime measurement,
    //     and HPKE key binding. Revisit only when a mechanical consumer needs an
    //     accepted-measurement policy (issue #62).
    //   - Dollar-denominated spend enforcement is NOT built. SEALED_RPD_LIMIT
    //     bounds exposure by request count instead. See the cost accounting
    //     section of api/AGENTS.md for the reconciliation design that supersedes
    //     it.
    "SEALED_ENABLED": "true",

    // Per-user daily request guardrail for keyed Sealed traffic. Campus Pass
    // uses the shared CAMPUS_RPD_LIMIT instead. Tinfoil credentials themselves
    // are unlimited because provider max_tokens is a lifetime ceiling rather
    // than a resetting budget; BayLeaf owns the daily policy at the API layer.
    "SEALED_RPD_LIMIT": "100",


    "SPENDING_LIMIT_DOLLARS": "5.0",
    "SPENDING_LIMIT_RESET": "daily",
    "KEY_NAME_TEMPLATE": "BayLeaf API for $email",
    "ALLOWED_EMAIL_DOMAIN": "ucsc.edu",
    "SYSTEM_PROMPT_PREFIX": "You are accessing the BayLeaf API (https://api.bayleaf.dev/),  UC Santa Cruz's locally-operated AI service. Help users develop capability they can carry forward—into their own work and into collaboration with others. Make reasoning visible. Teach what generalizes. Conversations are private and never used for training.",
    
    // Campus Pass: allow on-campus users to access without personal API keys
    "RECOMMENDED_MODEL": "openrouter:z-ai/glm-5.2",

    // Curated companion models for the OpenCode wellknown remote config.
    // Comma-separated namespaced slugs (openrouter: / vertex:). RECOMMENDED_MODEL is
    // injected automatically as the first entry; this list adds further picks the
    // user can select from /models in OpenCode without a full /v1/models browse.
    // Empty string is allowed and means "recommended model only".
    "OPENCODE_CURATED_MODELS": "openrouter:qwen/qwen3.6-27b,vertex:zai-org/glm-5-maas,openrouter:deepseek/deepseek-v4-flash",

    // Sealed recommendation and curated companions. These are bare Tinfoil IDs:
    // the dedicated /sealed route establishes provider provenance, while the
    // model field is inside the encrypted body and cannot be rewritten here.
    "SEALED_RECOMMENDED_MODEL": "glm-5-2",
    "SEALED_CURATED_MODELS": "kimi-k2-6,gemma4-31b,gpt-oss-120b",

    // OIDC authentication — provider-agnostic via .well-known discovery.
    // Currently configured for CILogon (https://www.cilogon.org/oidc).
    // For Google, use:
    //   OIDC_ISSUER: "https://accounts.google.com"
    //   OIDC_SCOPES: "openid email profile"
    //   OIDC_AUTHORIZE_PARAMS: "hd=ucsc.edu"
    //   OIDC_LOGIN_BUTTON_TEXT: "Sign in with UCSC Google"
    "OIDC_ISSUER": "https://cilogon.org",
    "OIDC_SCOPES": "openid email profile org.cilogon.userinfo",
    "OIDC_AUTHORIZE_PARAMS": "idphint=urn:mace:incommon:ucsc.edu",
    "OIDC_LOGIN_BUTTON_TEXT": "Sign in with UCSC",

    // Campus Pass: allow on-campus users to access without personal API keys
    // Set CAMPUS_IP_RANGES to enable (empty string = disabled).
    // Production ranges only — no loopback. Local dev sets DEV_LOOPBACK_AUTH=true
    // and overrides CAMPUS_IP_RANGES to include 127.0.0.1/32,::1/128 in .dev.vars
    // (see issue #52: getAuthIP trusts only CF-Connecting-IP and fails closed).
    "CAMPUS_IP_RANGES": "128.114.0.0/16,169.233.0.0/16,192.35.220.0/24,192.35.223.0/24,2607:F5F0::/32",
    "CAMPUS_SYSTEM_PREFIX": "Note: This user is accessing the API via shared on-campus access. They can provision a personal API key at no cost by visiting https://api.bayleaf.dev/",
    // Per-IP daily request limit for Campus Pass on /chat/completions and /responses.
    // IPv4: per address. IPv6: per /64. Resets at midnight UTC. Provider-agnostic
    // (charges against the same counter for OpenRouter and Vertex traffic).
    "CAMPUS_RPD_LIMIT": "100",

    // Sandbox: sandboxed code execution via Daytona
    "DAYTONA_API_URL": "https://app.daytona.io/api",
    "DAYTONA_PROXY_URL": "https://proxy.app.daytona.io/toolbox",
    // Unified with chat.bayleaf.dev (Lathe) so a user has one sandbox across
    // both services. See issue #14. The API never reads/writes the volume
    // mount Lathe may attach at /home/daytona/volume; only /home/daytona/workspace
    // is the shared filesystem surface.
    "DAYTONA_DEPLOYMENT_LABEL": "chat.bayleaf.dev",
    "DAYTONA_AUTO_DELETE_MINUTES": "129600"
  }

  // Secrets to configure via `wrangler secret put`:
  // - OPENROUTER_PROVISIONING_KEY
  // - OIDC_CLIENT_ID       (from your OIDC provider: CILogon, Google, etc.)
  // - OIDC_CLIENT_SECRET   (from your OIDC provider)
  // - CAMPUS_POOL_KEY (for Campus Pass feature)
  // - DAYTONA_API_KEY (for sandbox provider)
  // - BEDROCK_BEARER_TOKEN (Amazon Bedrock mantle bearer token; enterprise account in prod)
  // - TINFOIL_ADMIN_KEY    (Sealed lane: mints/deletes per-user Tinfoil keys.
  //                         Strictly more dangerous than OPENROUTER_PROVISIONING_KEY
  //                         because Tinfoil's admin API re-reveals key secrets on
  //                         read, so a leak exposes every user's inference
  //                         credential rather than only create/destroy rights.)
  // - TINFOIL_API_KEY      (Sealed lane: org key, used only for GET /sealed/models)
  // - CAMPUS_SEALED_KEY    (Sealed lane: shared, uncapped pool key for Campus Pass.
  //                         Campus exposure is bounded by CAMPUS_RPD_LIMIT per-IP
  //                         throttling: IPv4 per address, IPv6 aggregated to /64.)
  // - GWS_CLIENT_ID        (Google Workspace CLI OAuth client ID)
  // - GWS_CLIENT_SECRET    (Google Workspace CLI OAuth client secret)
  // - GWS_PROJECT_ID       (GCP project ID, e.g. "gws-cli-playground-ucsc")
}
