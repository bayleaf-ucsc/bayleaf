{
  "name": "bayleaf-api",
  "version": "1.0.0",
  "description": "BayLeaf API - Key provisioning and LLM inference proxy for UC Santa Cruz",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "pretest:previews": "python3 scripts/build-sandbox-plugin.py && python3 scripts/build-nanobot-assets.py --fixture",
    "pretest:grants": "python3 scripts/build-sandbox-plugin.py && python3 scripts/build-nanobot-assets.py --fixture",
    "pretest:sandbox-browser": "python3 scripts/build-sandbox-plugin.py && python3 scripts/build-nanobot-assets.py --fixture",
    "test:previews": "python3 scripts/test-preview-fixture.py && node scripts/harness-previews.mjs",
    "test:grants": "node scripts/harness-grants.mjs",
    "test:decisions": "node scripts/test-decisions.mjs",
    "test:sealed-dashboard": "node scripts/test-sealed-dashboard.mjs",
    "test:sealed-models": "node scripts/test-sealed-models.mjs",
    "test:campus-pass": "node scripts/test-campus-pass.mjs",
    "test:docs": "node scripts/test-docs.mjs",
    "test:sandbox-reaper": "node scripts/test-sandbox-reaper.mjs",
    "test:sandbox-browser": "python3 scripts/test-browser-setup.py && node scripts/test-sandbox-policy.mjs && node scripts/harness-sandbox-browser.mjs",
    "test:service-sessions": "node scripts/harness-service-sessions.mjs && node ../sandbox/test-worker.mjs",
    "test:user-activity": "node scripts/test-user-activity.mjs",
    "test:user-retention": "node scripts/test-user-retention.mjs",
    "test:telemetry": "node scripts/test-telemetry.mjs",
    "test:inboxes": "node scripts/test-inboxes.mjs",
    "test:inboxes-e2e": "node scripts/test-inboxes-e2e.mjs",
    "test:diagnostics": "node --test scripts/test-diagnostics.mjs && node scripts/test-inboxes-e2e.mjs",
    "test:sandbox-credentials": "node scripts/harness-sandbox-credentials.mjs",
    "test:sandbox-plugin": "npm --prefix sandbox-plugin test",
    "test:nanobot": "python3 scripts/build-nanobot-assets.py --fixture && npm --prefix nanobot-sandbox test && python3 scripts/test-nanobot-setup.py && python3 scripts/test-nanobot-assets.py",
    "test:jupyter": "python3 scripts/test-jupyter-setup.py",
    "test:ttyd": "python3 scripts/test-ttyd-setup.py",
    "tail": "wrangler tail"
  },
  "overrides": {
    "undici": "7.29.1",
    "sharp": "$sharp"
  },
  "keywords": [
    "cloudflare-workers",
    "openrouter",
    "ucsc",
    "bayleaf"
  ],
  "author": "UC Santa Cruz",
  "license": "MIT",
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260817.1",
    "esbuild": "^0.28.1",
    "miniflare": "5.20260811.1-alpha",
    "typescript": "^5.7.0",
    "wrangler": "^4.123.0"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.3.0",
    "hono": "^4.13.7",
    "sharp": "^0.35.5",
    "zod": "^4.3.6"
  }
}
